# Python bytecode and local environments
__pycache__/
*.py[cod]
*$py.class
.python-version
.venv/
venv/
env/

# Packaging/build products
build/
dist/
*.egg-info/
pip-wheel-metadata/

# Test/type/lint caches
.coverage
.coverage.*
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
htmlcov/

# Generated cluster outputs and logs
esub_logs/
*.log
*.out
*.err
*.o
*.e
*_done.dat
job.*
slurm-*.out

# Notebook local state
.ipynb_checkpoints/
notebooks/.ipynb_checkpoints/

# Legacy TensorFlow/Keras saved-model artifacts are too large for normal git.
# Commit the lightweight NPZ exports below instead.
saved_models/
saved_models_*/

# Keep only the lightweight validation fixture in data/.
data/*
!data/validation_all_spectra_500.h5

# Guard against accidental full training/data products elsewhere.
*.h5
*.hdf5
*.npz
*.npy
!data/validation_all_spectra_500.h5

# Lightweight JAX model exports are small enough to ship with the package.
!src/cmb_baryon_emu/lightweight_models/
!src/cmb_baryon_emu/lightweight_models/*.npz
